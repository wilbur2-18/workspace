{"width":1920,"height":1080,"startIndex":20,"clear":false,"slides":[{"i":21,"n":"Slide 21","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"text","s":"rect","n":"标题 1","b":[105.47,452.4,605.01,182.39,0],"t":"第二步\n探查数据表中的电话号码、银行卡号、身份证号等关键信息。","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"t"},{"k":"text","s":"rect","n":"标题 1","b":[105.47,238.37,604.93,174.79,0],"t":"第一步\n推断数据库中各表中每列的含义，并对单表进行摘要总结。","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"t"},{"k":"text","s":"rect","n":"标题 1","b":[105.47,674.03,609.47,182.39,0],"t":"第三步\n挖掘多表数据的深层次关系，并生成对应SQL","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"t"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"案例06实体漫游搜集｜跨库多维特征的深度挖掘","fs":36,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"image","n":"图片 7","b":[785.61,216.28,1060.79,310.18,0],"img":"media/image24.png"},{"k":"image","n":"图片 6","b":[785.61,301.73,1060.79,354.87,0],"img":"media/image25.png"},{"k":"image","n":"图片 8","b":[785.61,398.17,1060.79,274.26,0],"img":"media/image26.png"},{"k":"image","n":"图片 6","b":[963.2,511.5,705.6,371.76,0],"img":"media/image27.png"}]},{"i":22,"n":"Slide 22","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"shape","s":"roundRect","n":"圆角矩形 14","b":[98.9,352.3,1732.5,626.4,0],"f":"#00F2FF","fa":0.10027,"ln":{"color":"#00F2FF","alpha":0.70439,"weight":2.5}},{"k":"text","s":"rect","n":"文本框 1","b":[149.9,396.2,1601.3,549.5,0],"t":"赋予AI行动能力：为大模型配置读取、检索、抽取、比对、计算、生成等原子化工具，使其能够围绕具体风险任务执行多步骤操作。\n赋予AI专业能力：将专家的核查逻辑、规则匹配方式、风险识别方法和处置要求沉淀为标准化技能，支持重复调用和批量执行。\n统一的项目工作空间：每个专项任务拥有独立的隔离空间，项目资料、关联数据库、图谱、知识库按权限统一管理，避免工具分散、数据散落和成果难沉淀。\n沉浸式风控助手交互：审计人员可在同一界面中查看资料、调用图谱、查询数据库、检索制度，并通过自然语言引导AI开展风险识别、关联分析和线索追溯。\n审计技能沉淀：审计人员在平台中完成一次高质量的数据核查、风险分析、线索研判或依据链构建后，可以将其中的核查路径、判断规则、分析步骤和引用依据沉淀为标准化「审计技能」\n\n","fs":14,"bo":false,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"综合分析平台 人机协同的统一工作入口","fs":33,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 7","b":[149.9,175.7,1541.5,138.9,0],"t":"将数据、知识、图谱、智能体和审计成果统一收口,\n形成审计人员可操作、可复核、可沉淀的人机协同工作台。\n\n","fs":16,"bo":false,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"t"}]},{"i":23,"n":"Slide 23","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"text","s":"rect","n":"文本框 3","b":[121.77,211.56,488.78,283.4,0],"t":"单项目对话式审计\n审计人员上传资料，通过对话和大模型协同完成：关键信息提取、疑点初筛与确认、生成汇报总结。","fs":18,"bo":true,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"场景集成 覆盖从单项目到上下一盘棋的多维应用","fs":36,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 6","b":[1296.2,211.56,488.78,283.4,0],"t":"跨层级技能复用\n审计专家制定「政府投资审计技能」；市县审计局导入，直接复用专家经验开展标准化审计，实现“上下一盘棋”。","fs":18,"bo":true,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 7","b":[715.61,211.93,488.78,283.4,0],"t":"海量历史项目清洗\n审计人员将资料打包上传。创建跑批任务，大模型自规划执行，审计人员查看任务进度，关注异常列表与汇总报告。","fs":18,"bo":true,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"image","n":"图片 8","b":[166.06,540,400.21,400.21,0],"img":"media/image28.png"},{"k":"image","n":"图片 9","b":[752.58,540,401.12,401.12,0],"img":"media/image29.png"},{"k":"image","n":"图片 10","b":[1340.02,539.09,401.12,401.12,0],"img":"media/image30.png"}]},{"i":24,"n":"Slide 24","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"案例07大批量材料自动化批量审计","fs":36,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 1","b":[75.4,190.69,842.88,700.2,0],"t":"典型场景\n近百份项目资料（如招标文件、合同文件等），传统靠人工翻阅进行关键信息的查询与比对，并人工整理报告。\n\n技术路径\n通过「对话」和「审计技能」为大模型提供具体审计思路，大模型利用各类查询、分析比对工具，自规划完成大批量审计任务的自动执行。\n\n成效\n耗时3小时 自动审计上百份资料，自动产出数十份审计分析报告。","fs":18,"bo":true,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"image","n":"图片 2","b":[963.3,190.7,872,479.2,0],"img":"media/image31.png"},{"k":"image","n":"图片 3","b":[963.2,461.5,872.1,472.1,0],"img":"media/image32.png"}]}]}