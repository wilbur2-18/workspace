{"width":1920,"height":1080,"startIndex":16,"clear":false,"slides":[{"i":17,"n":"Slide 17","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"shape","s":"roundRect","n":"圆角矩形 16","b":[985.45,449.16,800.85,501.24,0],"f":"#00F2FF","fa":0.10027,"ln":{"color":"#00F2FF","alpha":0.70439,"weight":2.5}},{"k":"shape","s":"roundRect","n":"圆角矩形 14","b":[118.13,449.16,800.85,501.24,0],"f":"#00F2FF","fa":0.10027,"ln":{"color":"#00F2FF","alpha":0.70439,"weight":2.5}},{"k":"text","s":"rect","n":"文本框 3","b":[127.73,216.22,960,175.76,0],"t":"端到端自动化审计闭环\n把复杂的审计任务封装为自主执行的智能体流程，驱动审计作业从人工核查向自主作业跨越。","fs":18,"bo":true,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 5","b":[145.66,565.99,735.09,313.9,0],"t":"审计流程引擎化 自主规划并执行复杂、超大规模的审计任务链。\n智能成果闭环生成 自主开展探索分析，生成可解释 AI 结论、标准化底稿和报告初稿。\n辅助证据链构建 快速匹配和提取支持审计结论的关键证据，确保结论可溯源。","fs":14,"bo":false,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 7","b":[1022.59,556.72,726.55,313.9,0],"t":"实体漫游搜集 跨系统自动探查个人/企业实体的全维度分布情况。\n票据溯源追踪 基于发票链路递归查询，自动还原业务全景并识别违规风险。\n图谱全量探查 全量扫描关联网络，智能捕捉异常路径与利益输送线索。","fs":14,"bo":false,"it":false,"c":"#00F2FF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"标题 1","b":[52.75,46.75,1656,79.25,0],"t":"智能体平台 驱动审计作业的全流程自动化","fs":18,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 18","b":[146.51,484.46,960,72.27,0],"t":"大模型赋能","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 20","b":[1022.59,484.86,555.53,72.27,0],"t":"场景落地","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"top"}]},{"i":18,"n":"Slide 18","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"shape","s":"roundRect","n":"圆角矩形 13","b":[138.4,471.56,1609.87,443.32,0],"f":"#00F2FF","fa":0.10027,"ln":{"color":"#00F2FF","alpha":0.70439,"weight":2.5}},{"k":"text","s":"rect","n":"文本框 3","b":[169.87,501.13,1094.93,430.22,0],"t":"智能体能力\n递归链条溯源：从单张发票出发，根据销方名称自动递归查询并汇总各级上级发票信息。\n语义智能匹配：结合大模型能力，对商品名称等非标字段进行语义识别，穿透识别“马甲”企业与“模糊描述”。\n链路全景还原：自动构建发票链路全图，并对异常流转节点进行智能化标注，辅助证据链构建。\n","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"案例05票据溯源追踪｜多级流转链路的递归还原","fs":36,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 12","b":[138.4,211.3,1643.2,188.59,0],"t":"业务背景\n多级流转隐患：大宗商品交易往往涉及多级经销商，在中转销售链路中易出现违规操作。\n溯源核查挑战：传统审计难以在海量、碎片化的票据中快速理清多级流转的真实路径。","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"image","n":"图片 10","b":[1308.53,471.56,439.73,441.15,0],"img":"media/image20.png"}]},{"i":19,"n":"Slide 19","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"案例05票据溯源追踪｜多级流转链路的递归还原","fs":36,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"image","n":"图片 5","b":[118.4,188.48,1176.46,745.83,0],"img":"media/image21.png"},{"k":"image","n":"图片 6","b":[576.07,188.48,1200.88,756.78,0],"img":"media/image22.png"}]},{"i":20,"n":"Slide 20","nodes":[{"k":"shape","s":"rect","n":"矩形 14","b":[44.11,50.62,8.64,72.5,0],"f":"#00F2FF","fa":1,"ln":null},{"k":"image","n":"图片 4","b":[0,0,1920,1080,0],"img":"media/image3.png"},{"k":"shape","s":"roundRect","n":"圆角矩形 12","b":[138.4,471.56,1609.87,443.32,0],"f":"#00F2FF","fa":0.10027,"ln":{"color":"#00F2FF","alpha":0.70439,"weight":2.5}},{"k":"text","s":"rect","n":"文本框 3","b":[138.4,232.6,1656,175.76,0],"t":"业务背景核心痛点：关键审计信息（如电话、银行卡号、身份证号等）往往散落在多张数据表、多个业务系统中。\n分析挑战：缺乏统一的实体关联视图，人工难以发现多表之间的深层次逻辑联系。","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"标题 2","b":[52.75,46.75,1656,79.25,0],"t":"案例06实体漫游搜集｜跨库多维特征的深度挖掘","fs":36,"bo":false,"it":false,"c":"#111827","f":null,"fa":1,"ln":null,"va":"top"},{"k":"text","s":"rect","n":"文本框 11","b":[171.73,496.07,1044.8,379.33,0],"t":"智能体能力\n跨库分布探查：自动探查并汇总对应实体在各系统、各表中的分布情况与出现频次。\n字段智能推断：自动推断数据库中字段含义，并为单表生成业务摘要总结。\n深层关系挖掘：深度挖掘多表间的隐秘关联，并自动生成对应的 SQL 语句作为审计取证依据。","fs":18,"bo":true,"it":false,"c":"#FFFFFF","f":null,"fa":1,"ln":null,"va":"top"},{"k":"image","n":"图片 16","b":[1304.95,471.56,443.32,443.32,0],"img":"media/image23.png"}]}]}